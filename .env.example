# Copy to .env, paste each key right after its "=", no spaces or quotes. Never commit .env.
# Gemini: aistudio.google.com · Groq: console.groq.com · Tavily: app.tavily.com
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=


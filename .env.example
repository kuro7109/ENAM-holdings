# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=        # aistudio.google.com  -> results extraction, transcripts, research verdicts
GROQ_API_KEY=          # console.groq.com     -> bulk classification + one-line summaries
TAVILY_API_KEY=        # tavily.com           -> background of newly appointed executives (push side only)

